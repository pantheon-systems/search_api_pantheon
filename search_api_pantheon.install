<?php

/**
 * @file
 * Various hook implementations for installing the module.
 */

use Drupal\search_api\Entity\Server;
use Drupal\Core\Site\Settings;

/**
 * Uninstall deprecated search_api_pantheon_admin submodule.
 *
 * This update hook cleans up orphaned configuration entries for the
 * search_api_pantheon_admin submodule that is deprecated in 8.4.x.
 */
function search_api_pantheon_update_10080() {
  $config_factory = \Drupal::configFactory();

  // Clean up module from core.extension.
  $config = $config_factory->getEditable('core.extension');
  $modules = $config->get('module') ?: [];

  if (isset($modules['search_api_pantheon_admin'])) {
    unset($modules['search_api_pantheon_admin']);
    $config->set('module', $modules)->save(TRUE);
  }

  // Clean up system schema.
  \Drupal::keyValue('system.schema')->delete('search_api_pantheon_admin');

  // Clean up any configuration objects belonging to the submodule.
  $config_storage = \Drupal::service('config.storage');
  $config_names = $config_storage->listAll('search_api_pantheon_admin.');
  foreach ($config_names as $config_name) {
    $config_factory->getEditable($config_name)->delete();
  }

  // Clean up state entries.
  \Drupal::state()->delete('search_api_pantheon_admin');
  return t('Removed deprecated Search API Pantheon Admin submodule entries.');
}

/**
 * Implements hook_update_N().
 *
 * This update hook assists in the transition when upgrading the
 * module from earlier versions to 8.4.x
 * It updates the search server from 'pantheon_solr8' to 'pantheon_search'.
 */
function search_api_pantheon_update_10081() {
  $old_server_id = 'pantheon_solr8';
  $new_server_id = 'pantheon_search';
  $config_factory = \Drupal::configFactory();
  $pantheon_solr8_config = $config_factory->getEditable("search_api.server.pantheon_solr8");
  $pantheon_search_config = $config_factory->getEditable("search_api.server.pantheon_search");
  $logger = \Drupal::logger('search_api_pantheon');
  $default_search_server = Settings::get('default_search_server', NULL);

  // Skip if explicitly configured to use old server in settings.php.
  if ($default_search_server === 'pantheon_solr8') {
    $logger->warning('Migration skipped: default_search_server is set to "@old_server_id" in settings.php.', [
      '@old_server_id' => $old_server_id,
    ]);
    return t('Migration skipped: default_search_server set in settings.php.');
  }

  // Check stored config for indexes.
  $config_storage = \Drupal::service('config.storage');
  $index_config_names = $config_storage->listAll('search_api.index.');
  $indexes_to_migrate = [];

  foreach ($index_config_names as $config_name) {
    $config_data = $config_storage->read($config_name);
    if (isset($config_data['server']) && $config_data['server'] === $old_server_id) {
      $indexes_to_migrate[] = str_replace('search_api.index.', '', $config_name);
    }
  }

  // Skip if old server doesn't exist and no indexes need migration.
  if ($pantheon_solr8_config->isNew() && empty($indexes_to_migrate)) {
    return t('Migration of search server not needed.');
  }

  // Skip if new server exists and no indexes need migration (already complete).
  if (!$pantheon_search_config->isNew() && empty($indexes_to_migrate)) {
    return t('Migration already complete.');
  }

  try {
    $updated_indexes = [];

    // Create new server if it doesn't exist yet.
    if ($pantheon_search_config->isNew()) {
      $data = $pantheon_solr8_config->getRawData();
      $data['id'] = $new_server_id;
      $pantheon_search_config->setData($data)->save();
      $logger->info("Created search server '@new_server_id'.", [
        '@new_server_id' => $new_server_id,
      ]);
    }

    // Migrate indexes by updating stored config directly..
    foreach ($indexes_to_migrate as $index_id) {
      $config_name = "search_api.index.{$index_id}";
      $index_config = $config_factory->getEditable($config_name);
      $index_config->set('server', $new_server_id);
      $index_config->save();
      $updated_indexes[] = $index_id;
      $logger->info('Migrated index "@index" to "@new_server_id".', [
        '@index' => $index_id,
        '@new_server_id' => $new_server_id,
      ]);
    }

    // Delete old server only after all indexes are migrated.
    if (!$pantheon_solr8_config->isNew()) {
      // Verify no stored configs still reference the old server before deletion.
      $remaining_indexes = [];
      foreach ($index_config_names as $config_name) {
        $config_data = $config_storage->read($config_name);
        if (isset($config_data['server']) && $config_data['server'] === $old_server_id) {
          $remaining_indexes[] = str_replace('search_api.index.', '', $config_name);
        }
      }

      if (empty($remaining_indexes)) {
        $old_server = Server::load($old_server_id);
        if ($old_server) {
          $old_server->delete();
          $logger->info("Deleted old search server '@old_server_id'.", [
            '@old_server_id' => $old_server_id,
          ]);
        }
      }
      else {
        $logger->warning('Skipped deletion of @old_server_id: @count index(es) still reference it in stored config: @list', [
          '@old_server_id' => $old_server_id,
          '@count' => count($remaining_indexes),
          '@list' => implode(', ', $remaining_indexes),
        ]);
      }
    }

    // Build return message.
    if (!empty($updated_indexes)) {
      return t('Successfully migrated @count index(es) from @old to @new: @list', [
        '@count' => count($updated_indexes),
        '@old' => $old_server_id,
        '@new' => $new_server_id,
        '@list' => implode(', ', $updated_indexes),
      ]);
    }

    return t('Migration completed.');
  }
  catch (\Exception $e) {
    $logger->error('Migration failed: @message. Update can be safely re-run.', [
      '@message' => $e->getMessage(),
    ]);
    throw $e;
  }
}
