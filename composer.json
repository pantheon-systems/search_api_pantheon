{
    "name": "pantheon-systems/search_api_pantheon",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "description": "Connection module for Pantheon Search (solr 8)",
    "require-dev": {
        "drupal/coder": "2.0-beta1",
        "drupal/devel": "*"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "drupal/search_api_solr": "^4.2"
    },
    "require-dev": {
        "drupal/coder": "@stable",
        "squizlabs/php_codesniffer": "@stable"
    },
    "scripts": {
        "code:fix": [
            "vendor/bin/phpcs --config-set installed_paths vendor/drupal/coder/coder_sniffer",
            "vendor/bin/phpcbf . --ignore=vendor src modules"
        ],
        "code:lint": [
            "vendor/bin/phpcs --config-set installed_paths vendor/drupal/coder/coder_sniffer",
            "vendor/bin/phpcs --ignore=RoboFile.php,vendor . "
        ],
        "pre-commit": [
            "composer validate --strict",
            "@code:fix",
            "@code:lint"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
